# Copier vers .env.local et remplir avec les valeurs de Supabase
# (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL publique du site (liens de partage, QR codes, Open Graph, redirections Auth).
# En production : https://bingobuzz.vercel.app (ou votre domaine).
# Si absente sur Vercel, VERCEL_PROJECT_PRODUCTION_URL est utilisée.
NEXT_PUBLIC_SITE_URL=https://bingobuzz.vercel.app

# --- Facultatif : notifications push et tâche planifiée (README, Déploiement § 5) ---
# npm run vapid génère les deux clés VAPID.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
# Clé service_role : SERVEUR UNIQUEMENT (lib/supabase/admin.ts, server-only).
# Ne jamais lui donner le préfixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
PUSH_WEBHOOK_SECRET=
CRON_SECRET=
